#!/usr/bin/env python3
import os
import torch
import argparse
import json
import math
import numpy as np
from pathlib import Path
from dotenv import load_dotenv
from typing import List, Dict, Any, Optional, Tuple
load_dotenv()
from datasets import load_dataset
from typing import List, Dict, Any, Optional, Tuple
from transformers import AutoTokenizer, AutoModelForCausalLM
import numpy as np
from vllm import LLM, SamplingParams

# ---------------------------
# Helpers
# ---------------------------

def expand(path: str) -> str:
    return os.path.abspath(os.path.expanduser(path))

def _truncate(s: Optional[str], n: int = 200) -> str:
    if s is None:
        return ""
    s = str(s)
    if len(s) <= n:
        return s
    return s[:n] + f"...<truncated {len(s)} chars>"

def build_messages(prompt: str, answer1: str, answer2: str) -> List[Dict[str, str]]:
    system_msg = "You are an impartial and unbiased judge."
    user_content = (
        "You will be given answers from two assistants (Assistant A and Assistant B) to a user prompt. "
        "Please act as an impartial judge and evaluate the quality of their answers. "
        "You must output only one of the following choices:\n"
        "'A' if Assistant A’s answer is better.\n"
        "'T' if both answers are relatively the same in quality.\n"
        "'B' if Assistant B’s answer is better.\n"
        "Output exactly one character: A, B, or T. Do not include spaces or newlines.\n"
        "<User Prompt>\n"
        f"{prompt}\n"
        "<The Start of Assistant A’s Answer>\n"
        f"{answer1}\n"
        "<The End of Assistant A’s Answer>\n"
        "<The Start of Assistant B’s Answer>\n"
        f"{answer2}\n"
        "<The End of Assistant B’s Answer>"
    )
    return [{"role": "system", "content": system_msg},
            {"role": "user", "content": user_content}]

def apply_chat_template(llm: LLM, messages: List[Dict[str, str]]) -> str:
    tok = llm.get_tokenizer()
    return tok.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
def apply_chat_template(tokenizer, messages: List[Dict[str, str]]) -> str:
    # tokenizer.apply_chat_template exists for many HF tokenizers used in this repo
    return tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)

ABT_STRIPPED = {"A", "B", "T"}

def decode_token(tokenizer, tid: int) -> str:
    try:
        return tokenizer.decode([tid], skip_special_tokens=False)
    except Exception:
        return ""

def step_topk_to_prob_maps(step_obj, tokenizer) -> Dict[str, float]:
    """
    Convert a vLLM step top-k structure into {decoded_token_text -> probability}.
    Input values are logprobs; we exponentiate to probabilities (unnormalized across vocab).
    Handles:
      * list/tuple of TokenLogprob-like objects
      * dict[int -> Logprob(...)] (matches your printout)
      * dict[str/int -> float]
    """
    text_to_prob: Dict[str, float] = {}

    # Debug: top-level info
    try:
        print("[DEBUG] step_topk_to_prob_maps called. step_obj type:", type(step_obj))
        repr_str = _truncate(repr(step_obj), 800)
        print("[DEBUG] step_obj repr (truncated):", repr_str)
    except Exception as e:
        print("[DEBUG] Error when printing step_obj repr:", e)

    # Helper: convert logits (numpy/torch) to prob map by taking top-k
    def _logits_to_topk_map(logits, topk: int = 200):
        try:
            # Convert to numpy
            if hasattr(logits, 'cpu'):
                # likely a torch tensor
                arr = logits.detach().cpu().numpy()
            else:
                arr = np.array(logits)
            if arr.ndim != 1:
                arr = arr.flatten()
        # Load HF tokenizer and model
        tokenizer = AutoTokenizer.from_pretrained(
            args.base_model,
            trust_remote_code=args.trust_remote_code,
            padding_side="left",
        )
        if tokenizer is not None and tokenizer.pad_token_id is None:
            tokenizer.pad_token = tokenizer.eos_token

        model = AutoModelForCausalLM.from_pretrained(
            args.base_model,
            torch_dtype=getattr(torch, args.dtype) if hasattr(torch, args.dtype) else torch.bfloat16,
            trust_remote_code=args.trust_remote_code,
            device_map="auto",
        )
        model.eval()
            idxs = np.argpartition(-arr, k-1)[:k]
            # sort these idxs by descending logit
            idxs = idxs[np.argsort(-arr[idxs])]
            for token_id in idxs:
                lp = float(arr[int(token_id)])
                prob = float(np.exp(lp - np.max(arr))) if np.isfinite(lp) else 0.0
                # use decode_token for id
                ttext = decode_token(tokenizer, int(token_id))
                text_to_prob[str(ttext)] = prob
            return True
        except Exception as e:
            print("[DEBUG] _logits_to_topk_map failed:", e)
            return False

    # HuggingFace style: dict with 'topk_tokens'/'topk_logprobs' or 'topk_ids'/'topk_logprobs'
    if isinstance(step_obj, dict):
        # quick checks for HF-style keys
        if ('topk_tokens' in step_obj and 'topk_logprobs' in step_obj) or ('topk_ids' in step_obj and 'topk_logprobs' in step_obj):
            print("[DEBUG] Detected HF-style topk lists in dict")
            tk_tokens = step_obj.get('topk_tokens') or step_obj.get('topk_ids')
            tk_logprobs = step_obj.get('topk_logprobs')
            try:
                for t, lp in zip(tk_tokens, tk_logprobs):
                    # tokens might be ids or text
                    if isinstance(t, (int, np.integer)):
                        ttext = decode_token(tokenizer, int(t))
                    else:
                        ttext = t
                    try:
                        prob = math.exp(float(lp))
                    except Exception:
                        prob = 0.0
                    text_to_prob[str(ttext)] = prob
                    print(f"[DEBUG][hf-topk] token={_truncate(ttext,80)} logprob={lp} -> prob={prob}")
            except Exception as e:
                print("[DEBUG] error processing hf-style topk lists:", e)
            # final summary below
        elif 'logits' in step_obj or 'scores' in step_obj:
            arr = step_obj.get('logits') if 'logits' in step_obj else step_obj.get('scores')
            print(f"[DEBUG] Detected HF-style logits/scores in dict, type={type(arr)}")
            # try to convert logits to topk map
            if not _logits_to_topk_map(arr):
                prompt_jr = apply_chat_template(tokenizer, msgs_jr)
                prompt_rj = apply_chat_template(tokenizer, msgs_rj)
            # Fall back to original dict handling (vLLM style or simple map)
            print(f"[DEBUG] step_obj is a dict with {len(step_obj)} keys (falling back to legacy handling)")
            try:
                sample_items = list(step_obj.items())[:10]
                for k, v in sample_items:
                    print(f"[DEBUG][dict-sample] key={k} val_type={type(v)} val_repr={_truncate(repr(v),200)}")
            except Exception as e:
                print("[DEBUG] error while sampling dict entries:", e)

                # Tokenize prompts as a batch
                inputs = tokenizer([prompt_jr, prompt_rj], return_tensors="pt", padding=True, truncation=True, add_special_tokens=False)
                device = model.device
                input_ids = inputs["input_ids"].to(device)
                attention_mask = inputs.get("attention_mask", None)
                if attention_mask is not None:
                    attention_mask = attention_mask.to(device)

                # Generate with scores so we can access logits per generated step
                gen_out = model.generate(
                    input_ids=input_ids,
                    attention_mask=attention_mask,
                    do_sample=False,
                    max_new_tokens=args.max_tokens,
                    return_dict_in_generate=True,
                    output_scores=True,
                    pad_token_id=tokenizer.pad_token_id,
                )

                # sequences: (batch, seq_len); scores: tuple(len_generated_steps) each (batch, vocab)
                sequences = gen_out.sequences
                scores = list(gen_out.scores)  # length = num_generated_steps

                # compute per-example prompt lengths (non-padded tokens)
                if "attention_mask" in inputs:
                    prompt_lens = inputs["attention_mask"].sum(dim=1).tolist()
                else:
                    # fallback: count non-pad tokens
                    prompt_lens = (inputs["input_ids"] != tokenizer.pad_token_id).sum(dim=1).tolist()

                # Helper to find first A/B/T step and produce probs
                def _process_example(batch_idx: int) -> Tuple[Optional[int], str, Dict[str, float]]:
                    gen_len = sequences.shape[1] - prompt_lens[batch_idx]
                    chosen_text = tokenizer.decode(sequences[batch_idx, prompt_lens[batch_idx]:].tolist(), skip_special_tokens=False)
                    # find first generated step whose token decodes to A/B/T
                    step_idx = None
                    for j in range(gen_len):
                        tid = int(sequences[batch_idx, prompt_lens[batch_idx] + j].item())
                        ttext = decode_token(tokenizer, tid)
                        if ttext.strip() in ABT_STRIPPED:
                            step_idx = j
                            break
                    probs_map = {"A": 0.0, "B": 0.0, "T": 0.0}
                    if step_idx is not None and step_idx < len(scores):
                        logits = scores[step_idx][batch_idx]
                        text_prob_map = step_topk_to_prob_maps(logits, tokenizer)
                        probs_map = only_abt_probs(text_prob_map)
                    return step_idx, chosen_text, probs_map

                # JR is batch index 0, RJ is batch index 1
                jr_step_idx, jr_text, jr_probs = _process_example(0)
                jr_norm = normalize_probs_abc(jr_probs)

                rj_step_idx, rj_text, rj_probs = _process_example(1)
                rj_norm = normalize_probs_abc(rj_probs)
                    if hasattr(v, "logprob"):
                        lp = float(getattr(v, "logprob"))
                        decoded = getattr(v, "decoded_token", None)
                        prob = math.exp(lp)
                        if isinstance(k, int):
                            ttext = decoded if decoded is not None else decode_token(tokenizer, k)
                        else:
                            ttext = decoded if decoded is not None else str(k)
                        text_to_prob[str(ttext)] = prob
                        print(f"[DEBUG][dict] key={k} decoded={_truncate(decoded,80)} ttext={_truncate(ttext,80)} logprob={lp} -> prob={prob}")
                    else:
                        # bare float logprob
                        try:
                            lp = float(v)
                        except Exception:
                            print(f"[DEBUG][dict] key={k} value not convertible to float, skipping: {repr(v)[:200]}")
                            continue
                        prob = math.exp(lp)
                        if isinstance(k, int):
                            ttext = decode_token(tokenizer, k)
                        else:
                            ttext = str(k)
                        text_to_prob[str(ttext)] = prob
                        print(f"[DEBUG][dict] key={k} bare-float logprob={lp} -> decoded token {_truncate(ttext,80)} prob={prob}")
                except Exception as e:
                    print(f"[DEBUG][dict] exception while processing key={k}: {e}")
    elif isinstance(step_obj, (list, tuple)):
        print(f"[DEBUG] step_obj is a list/tuple with {len(step_obj)} entries (legacy list handling)")
        for idx, tlp in enumerate(step_obj):
            try:
                lpr = getattr(tlp, "logprob", None)
                decoded = getattr(tlp, "decoded_token", None)
                text_attr = getattr(tlp, "text", None)
                tid = getattr(tlp, "token_id", None)
                print(f"[DEBUG][list] idx={idx} token_id={tid} decoded={_truncate(decoded,80)} text_attr={_truncate(text_attr,80)} logprob={lpr}")
                if lpr is None:
                    print(f"[DEBUG][list] idx={idx} skipping because logprob is None")
                    continue
                ttext = decoded or text_attr
                if ttext is None and tid is not None:
                    try:
                        ttext = decode_token(tokenizer, int(tid))
                        print(f"[DEBUG][list] idx={idx} decoded via tokenizer: {_truncate(ttext,80)}")
                    except Exception as e:
                        print(f"[DEBUG][list] idx={idx} failed to decode token id {tid}: {e}")
                if ttext is not None:
                    prob = math.exp(float(lpr))
                    text_to_prob[str(ttext)] = prob
                    print(f"[DEBUG][list] idx={idx} mapped '{_truncate(ttext,80)}' -> prob={prob}")
            except Exception as e:
                print(f"[DEBUG][list] idx={idx} exception while processing entry: {e}")
    else:
        print(f"[DEBUG] step_obj is neither list/tuple nor dict (type={type(step_obj)}). Attempting best-effort handling.")
        try:
            # handle raw logits array/tensor
            if hasattr(step_obj, 'ndim') or hasattr(step_obj, 'shape') or hasattr(step_obj, 'cpu'):
                if _logits_to_topk_map(step_obj):
                    pass
                else:
                    print("[DEBUG] raw logits handling failed")
            else:
                for idx, item in enumerate(step_obj):
                    lpr = getattr(item, "logprob", None)
                    decoded = getattr(item, "decoded_token", None) or getattr(item, "text", None)
                    tid = getattr(item, "token_id", None)
                    print(f"[DEBUG][iter] idx={idx} token_id={tid} decoded={_truncate(decoded,80)} logprob={lpr}")
                    if lpr is None:
                        continue
                    if decoded is None and tid is not None:
                        decoded = decode_token(tokenizer, int(tid))
                    if decoded is not None:
                        text_to_prob[str(decoded)] = math.exp(float(lpr))
        except Exception as e:
            print(f"[DEBUG] fallback iterable handling failed: {e}")

    # Final debug summary
    try:
        print(f"[DEBUG] Built text_to_prob map with {len(text_to_prob)} entries")
        top_items = sorted(text_to_prob.items(), key=lambda kv: kv[1], reverse=True)[:10]
        for t, p in top_items:
            print(f"[DEBUG] top token: '{_truncate(t,80)}' -> {p}")
    except Exception as e:
        print("[DEBUG] error during final summary:", e)

    return text_to_prob

def find_first_letter_step(out, tokenizer) -> Tuple[Optional[int], str]:
    """
    Return the index of the first generated step whose chosen token (after .strip())
    is A/B/T, and also return the model's full generated text for reference.
    """
    gen_text = out.text
    chosen_ids = getattr(out, "token_ids", []) or []
    lp_list = getattr(out, "logprobs", []) or []
    n_steps = min(len(chosen_ids), len(lp_list))
    for idx in range(n_steps):
        tid = int(chosen_ids[idx])
        ttext = decode_token(tokenizer, tid)
        if ttext.strip() in ABT_STRIPPED:
            return idx, gen_text
    return None, gen_text

def only_abt_probs(text_prob_map: Dict[str, float]) -> Dict[str, float]:
    # Collect probabilities for exactly tokens that decode as A/B/T (and common whitespace-prefixed variants)
    aliases = {
        "A": {"A", "▁A", " A", "\nA", "\tA"},
        "B": {"B", "▁B", " B", "\nB", "\tB"},
        "T": {"T", "▁T", " T", "\nT", "\tT"},
    }
    out = {"A": 0.0, "B": 0.0, "T": 0.0}
    for letter, alset in aliases.items():
        out[letter] = max((text_prob_map.get(a, 0.0) for a in alset), default=0.0)
    return out

def normalize_probs_abc(prob_map: Dict[str, float]) -> Dict[str, float]:
    total = prob_map["A"] + prob_map["B"] + prob_map["T"]
    if total <= 0:
        # fall back to uniform so they sum to 1
        return {"A": 1/3, "B": 1/3, "T": 1/3}
    return {k: prob_map[k] / total for k in ["A", "B", "T"]}

# ---------------------------
# Main
# ---------------------------

def parse_args():
    p = argparse.ArgumentParser(description="A/B/T probabilities from Llama-3.1-8B-Instruct for two prompt orders.")
    p.add_argument("--output_path", type=str, required=True, help="Where to write JSONL output.")
    p.add_argument("--data_jsonl", type=str,
                   default="/home/ubuntu/dani/data_explorations/llama_gpt_math_comparison.jsonl",
                   help="JSONL fields: question, judge_completion, ref_completion; optional: judge_correct, ref_correct.")
    p.add_argument("--limit", type=int, default=0, help="Max rows; 0 = all.")
    # Model / vLLM
    p.add_argument("--base_model", type=str, default="meta-llama/Meta-Llama-3.1-8B-Instruct")
    p.add_argument("--dtype", type=str, default="float32")
    p.add_argument("--tp_size", type=int, default=1)
    p.add_argument("--gpu_memory_utilization", type=float, default=0.9)
    p.add_argument("--trust_remote_code", action="store_true")
    p.add_argument("--quantization", type=str, default="bitsandbytes")
    p.add_argument("--kv_cache_dtype", type=str, default=None)
    # Decoding
    p.add_argument("--logprobs_k", type=int, default=20)
    p.add_argument("--max_tokens", type=int, default=2)
    return p.parse_args()

def main():
    args = parse_args()
    torch.set_float32_matmul_precision('high')
    # Load dataset
    ds = load_dataset("json", data_files=expand(args.data_jsonl))["train"]
    if args.limit and args.limit > 0:
        ds = ds.select(range(min(args.limit, len(ds))))

    # Build LLM (quantized)
    llm_kwargs = dict(
        model=args.base_model,
        dtype=args.dtype,
        max_model_len=14592,
        hf_token=os.getenv("HF_TOKEN"),
        tensor_parallel_size=args.tp_size,
        trust_remote_code=args.trust_remote_code,
        gpu_memory_utilization=args.gpu_memory_utilization,
    )
    # if args.quantization:
    #     llm_kwargs["quantization"] = args.quantization
    if args.kv_cache_dtype:
        llm_kwargs["kv_cache_dtype"] = args.kv_cache_dtype

    llm = LLM(**llm_kwargs)
    tokenizer = llm.get_tokenizer()

    sampling_params = SamplingParams(
        temperature=0.0,
        top_p=1.0,
        max_tokens=args.max_tokens,  # 2 helps skip leading whitespace/newline if any
        logprobs=args.logprobs_k,
    )

    out_path = Path(expand(args.output_path))
    out_path.parent.mkdir(parents=True, exist_ok=True)

    processed = 0
    with out_path.open("w", encoding="utf-8") as f_out:
        for i in range(len(ds)):
            row = ds[i]
            question = (row.get("question") or "").strip()
            judge_comp = (row.get("judge_completion") or "").strip()
            ref_comp = (row.get("ref_completion") or "").strip()
            if not question or not judge_comp or not ref_comp:
                continue
            judge_correct = row.get("judge_correct", None)
            ref_correct = row.get("ref_correct", None)

            # Two orders
            msgs_jr = build_messages(question, judge_comp, ref_comp)  # A=judge, B=ref
            msgs_rj = build_messages(question, ref_comp, judge_comp)  # A=ref,   B=judge

            # Debug: print built messages with truncated contents
            try:
                print(f"[DEBUG] Row {i}: built msgs_jr with {len(msgs_jr)} messages")
                for mi, m in enumerate(msgs_jr):
                    role = m.get("role")
                    content = _truncate(m.get("content"), 400)
                    print(f"[DEBUG] msgs_jr[{mi}] role={role} content={content}")
                print(f"[DEBUG] Row {i}: built msgs_rj with {len(msgs_rj)} messages")
                for mi, m in enumerate(msgs_rj):
                    role = m.get("role")
                    content = _truncate(m.get("content"), 400)
                    print(f"[DEBUG] msgs_rj[{mi}] role={role} content={content}")
            except Exception as e:
                print("[DEBUG] error while printing built messages:", e)

            prompt_jr = apply_chat_template(llm, msgs_jr)
            prompt_rj = apply_chat_template(llm, msgs_rj)

            # Debug: show prompt templates (truncated) and sampling params
            try:
                print(f"[DEBUG] prompt_jr (truncated): {_truncate(prompt_jr,600)}")
                print(f"[DEBUG] prompt_rj (truncated): {_truncate(prompt_rj,600)}")
                print(f"[DEBUG] sampling_params: temperature={sampling_params.temperature} top_p={sampling_params.top_p} max_tokens={sampling_params.max_tokens} logprobs={sampling_params.logprobs}")
            except Exception as e:
                print("[DEBUG] error while printing prompts/sampling params:", e)

            outs = llm.generate([prompt_jr, prompt_rj], sampling_params=sampling_params)
            out_jr, out_rj = outs[0].outputs[0], outs[1].outputs[0]

            # --- JR ---
            jr_step_idx, jr_text = find_first_letter_step(out_jr, tokenizer)
            jr_text = out_jr.text
            jr_probs = {"A": 0.0, "B": 0.0, "T": 0.0}
            if jr_step_idx is not None:
                jr_text_prob_map = step_topk_to_prob_maps(out_jr.logprobs[jr_step_idx], tokenizer)
                print(f"[DEBUG] JR order step {jr_step_idx} text_prob_map sample: {list(jr_text_prob_map.items())[:10]}")
                jr_probs = only_abt_probs(jr_text_prob_map)
                print(f"[DEBUG] JR order step {jr_step_idx} post-abt probabilities: {jr_probs}")
            jr_norm = normalize_probs_abc(jr_probs)

            # --- RJ ---
            rj_step_idx, rj_text = find_first_letter_step(out_rj, tokenizer)
            rj_text = out_rj.text
            rj_probs = {"A": 0.0, "B": 0.0, "T": 0.0}
            if rj_step_idx is not None:
                rj_text_prob_map = step_topk_to_prob_maps(out_rj.logprobs[rj_step_idx], tokenizer)
                rj_probs = only_abt_probs(rj_text_prob_map)
            rj_norm = normalize_probs_abc(rj_probs)
            
            
            for p_1, p_2 in [('A', 'B'), ('A', 'T'), ('B', 'T')]:
                if rj_probs != {"A": 0.0, "B": 0.0, "T": 0.0}:
                    assert not np.isclose(rj_probs[p_1], rj_probs[p_2]), f"RJ probs not distinct: {rj_probs}"
                if jr_probs != {"A": 0.0, "B": 0.0, "T": 0.0}:
                    assert not np.isclose(jr_probs[p_1], jr_probs[p_2]), f"JR probs not distinct: {jr_probs}"


            # Combined (sum probabilities from both orders, then normalize to sum=1)
            combined_probs = {k: jr_probs[k] + rj_probs[k] for k in ["A", "B", "T"]}
            combined_norm = normalize_probs_abc(combined_probs)

            rec = {
                "row_index": int(i),
                "question": question,
                "judge_completion": judge_comp,
                "ref_completion": ref_comp,
                "judge_correct": judge_correct,
                "ref_correct": ref_correct,
                "model": args.base_model,
                "outputs": {
                    "JR_order_text": jr_text,
                    "RJ_order_text": rj_text,
                },
                "probabilities": {
                    "JR_order": jr_probs,         # probs for A/B/T at the letter step
                    "RJ_order": rj_probs,
                    "combined": combined_probs,   # JR+RJ (not normalized)
                },
                "normalized": {
                    "JR_order": jr_norm,          # sums to 1
                    "RJ_order": rj_norm,          # sums to 1
                    "combined": combined_norm,    # sums to 1
                },
            }
            f_out.write(json.dumps(rec, ensure_ascii=False) + "\n")
            processed += 1

    print(f"Processed {processed} rows → {out_path}")

if __name__ == "__main__":
    main()

